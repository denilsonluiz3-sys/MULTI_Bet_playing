<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MULTI_Bet_playing_Demo.Models"
             x:Class="MULTI_Bet_playing_Demo.Pages.HomePage"
             Title="Início"
             BackgroundColor="{DynamicResource Background}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="12">

        <Picker x:Name="FilterPicker"
                Title="Filtrar"
                SelectedIndexChanged="OnFilterChanged"
                TextColor="{DynamicResource TextPrimary}"
                TitleColor="{DynamicResource TextSecondary}"
                BackgroundColor="{DynamicResource Surface}"
                Margin="0,0,0,8">
            <Picker.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Todos</x:String>
                    <x:String>Favoritos</x:String>
                    <x:String>Recentes</x:String>
                </x:Array>
            </Picker.ItemsSource>
        </Picker>

        <CollectionView x:Name="CardsCollection"
                        Grid.Row="1"
                        SelectionMode="None"
                        ItemsLayout="VerticalGrid, 2">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CardItem">
                    <Border Stroke="{DynamicResource Border}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{DynamicResource CardBackground}"
                            Margin="6"
                            Padding="12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCardTapped" CommandParameter="{Binding .}" />
                            <SwipeGestureRecognizer Direction="Left" Swiped="OnCardSwiped" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                            <Label Text="{Binding Icon}"
                                   FontSize="32"
                                   HorizontalOptions="Center"
                                   Grid.ColumnSpan="2" />
                            <Label Text="{Binding Title}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="TailTruncation"
                                   Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Margin="0,4,0,0" />
                            <Label Text="{Binding IsFavorite, StringFormat='{0}'}"
                                   IsVisible="{Binding IsFavorite}"
                                   Text="⭐"
                                   FontSize="16"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   HorizontalOptions="End" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                    <Label Text="🎰" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="Nenhum cassino adicionado"
                           TextColor="{DynamicResource TextSecondary}"
                           HorizontalOptions="Center" />
                    <Label Text="Toque no + para adicionar"
                           TextColor="{DynamicResource TextSecondary}"
                           FontSize="12"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <Button x:Name="AddButton"
                Grid.Row="2"
                Text="＋"
                FontSize="28"
                WidthRequest="56"
                HeightRequest="56"
                CornerRadius="28"
                BackgroundColor="{DynamicResource Primary}"
                TextColor="White"
                HorizontalOptions="End"
                Margin="0,12,4,4"
                Clicked="OnAddClicked" />
    </Grid>
</ContentPage>
