<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MULTI_Bet_playing_Demo.Models"
             x:Class="MULTI_Bet_playing_Demo.Pages.HomePage"
             Title="Início"
             BackgroundColor="{DynamicResource Background}">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="12">
        <Label x:Name="FilterLabel" Text="Filtro: Todos" FontSize="13"
               TextColor="{DynamicResource TextSecondary}" Margin="0,0,0,8" />

        <CollectionView x:Name="CardsCollection" Grid.Row="1" SelectionMode="None" ItemsLayout="VerticalGrid, 2">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CardItem">
                    <Border Stroke="{DynamicResource Border}" StrokeThickness="1"
                            StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource CardBackground}"
                            Margin="6" Padding="10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCardTapped" CommandParameter="{Binding .}" />
                            <SwipeGestureRecognizer Direction="Left" Swiped="OnCardSwiped" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                            <Label Text="{Binding Icon}" FontSize="28" HorizontalOptions="Center" />
                            <Label Text="{Binding Title}" FontSize="13" FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}" HorizontalTextAlignment="Center"
                                   LineBreakMode="TailTruncation" Grid.Row="1" />
                            <Label Text="{Binding Category}" FontSize="11" HorizontalTextAlignment="Center"
                                   TextColor="{DynamicResource TextSecondary}" Grid.Row="2" />
                            <Button Text="⭐ Favorito"
                                    FontSize="12"
                                    BackgroundColor="{DynamicResource Primary}"
                                    TextColor="White"
                                    HeightRequest="36"
                                    Padding="8,0"
                                    Grid.Row="3"
                                    HorizontalOptions="Fill"
                                    Clicked="OnFavoriteClicked"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8" Padding="16">
                    <Label Text="🎰" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="Nenhum link neste filtro" TextColor="{DynamicResource TextSecondary}" HorizontalOptions="Center" />
                    <Label Text="Use + para adicionar · menu ☰ para Todos/Favoritos/Recentes"
                           TextColor="{DynamicResource TextSecondary}" FontSize="12" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <Button Grid.Row="2" Text="＋" FontSize="28" WidthRequest="56" HeightRequest="56" CornerRadius="28"
                BackgroundColor="{DynamicResource Primary}" TextColor="White" HorizontalOptions="End"
                Margin="0,8,4,4" Clicked="OnAddClicked" />

        <Label Grid.Row="3" Text="Links de terceiros · 18+ · Não operamos jogos" FontSize="10"
               TextColor="{DynamicResource TextSecondary}" HorizontalTextAlignment="Center" />
    </Grid>
</ContentPage>
