<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MULTI_Bet_playing_Demo.Pages.CompliancePage"
             Title="Aviso legal"
             BackgroundColor="{DynamicResource Background}"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="MULTI Bet"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource Primary}"
                   HorizontalOptions="Center"
                   Margin="0,24,0,0" />

            <Label Text="Antes de continuar"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource TextPrimary}"
                   HorizontalOptions="Center" />

            <Border Stroke="{DynamicResource Border}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{DynamicResource CardBackground}"
                    Padding="16">
                <Label x:Name="DisclaimerLabel"
                       FontSize="13"
                       TextColor="{DynamicResource TextSecondary}"
                       LineBreakMode="WordWrap" />
            </Border>

            <CheckBox x:Name="AgeCheck" Color="{DynamicResource Primary}" />
            <Label Text="Confirmo que tenho 18 anos ou mais"
                   TextColor="{DynamicResource TextPrimary}"
                   FontSize="14"
                   Margin="0,-12,0,0" />

            <CheckBox x:Name="TermsCheck" Color="{DynamicResource Primary}" />
            <Label Text="Li e aceito os avisos (nao sou operador; links de terceiros)"
                   TextColor="{DynamicResource TextPrimary}"
                   FontSize="14"
                   Margin="0,-12,0,0" />

            <CheckBox x:Name="RegionCheck" Color="{DynamicResource Primary}" />
            <Label Text="Confirmei que o acesso a sites de jogo e permitido na minha regiao"
                   TextColor="{DynamicResource TextPrimary}"
                   FontSize="14"
                   Margin="0,-12,0,0" />

            <Button Text="Aceitar e continuar"
                    Clicked="OnAccept"
                    BackgroundColor="{DynamicResource Primary}"
                    TextColor="White"
                    HeightRequest="48"
                    Margin="0,12,0,0" />

            <Button Text="Sair"
                    Clicked="OnExit"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource Accent}"
                    HeightRequest="40" />

            <Label Text="Jogue com responsabilidade."
                   FontSize="11"
                   TextColor="{DynamicResource TextSecondary}"
                   HorizontalTextAlignment="Center"
                   Margin="0,8,0,24" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
