<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MULTI_Bet_playing_Demo.Pages.DemoPage"
             Title="Jogar Demo"
             BackgroundColor="{DynamicResource Background}">

    <Grid RowDefinitions="32,*" Padding="2" RowSpacing="2">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="2" Padding="2,0">
            <Label Text="Demo 2×2" FontSize="11" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="⭐" Clicked="OnLoadFavorites" FontSize="14" HeightRequest="28" WidthRequest="36" Padding="0" BackgroundColor="{DynamicResource Primary}" TextColor="White" />
            <Button Grid.Column="2" Text="🎮" Clicked="OnLoadPragmatic" FontSize="14" HeightRequest="28" WidthRequest="36" Padding="0" BackgroundColor="{DynamicResource Secondary}" TextColor="Black" />
            <Button Grid.Column="3" Text="＋" Clicked="OnPickSlots" FontSize="14" HeightRequest="28" WidthRequest="36" Padding="0" BackgroundColor="{DynamicResource Surface}" TextColor="{DynamicResource TextPrimary}" BorderColor="{DynamicResource Border}" BorderWidth="1" />
            <Button Grid.Column="4" x:Name="MuteBtn" Text="🔇" Clicked="OnMuteAll" FontSize="14" HeightRequest="28" WidthRequest="36" Padding="0" BackgroundColor="{DynamicResource Surface}" TextColor="{DynamicResource TextPrimary}" BorderColor="{DynamicResource Border}" BorderWidth="1" />
            <Button Grid.Column="5" Text="↻" Clicked="OnReloadAll" FontSize="14" HeightRequest="28" WidthRequest="36" Padding="0" BackgroundColor="{DynamicResource Surface}" TextColor="{DynamicResource TextPrimary}" BorderColor="{DynamicResource Border}" BorderWidth="1" />
            <Button Grid.Column="6" Text="⌫" Clicked="OnClearAll" FontSize="14" HeightRequest="28" WidthRequest="36" Padding="0" BackgroundColor="{DynamicResource Accent}" TextColor="White" />
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="*,*" ColumnDefinitions="*,*" RowSpacing="2" ColumnSpacing="2">
            <Border Grid.Row="0" Grid.Column="0" Stroke="{DynamicResource Border}" StrokeThickness="1" StrokeShape="RoundRectangle 4" BackgroundColor="{DynamicResource Surface}" Padding="0">
                <Grid RowDefinitions="16,*">
                    <Label x:Name="Label1" Text="1" FontSize="10" TextColor="{DynamicResource TextSecondary}" Margin="3,0" />
                    <WebView x:Name="WebView1" Grid.Row="1" />
                </Grid>
            </Border>
            <Border Grid.Row="0" Grid.Column="1" Stroke="{DynamicResource Border}" StrokeThickness="1" StrokeShape="RoundRectangle 4" BackgroundColor="{DynamicResource Surface}" Padding="0">
                <Grid RowDefinitions="16,*">
                    <Label x:Name="Label2" Text="2" FontSize="10" TextColor="{DynamicResource TextSecondary}" Margin="3,0" />
                    <WebView x:Name="WebView2" Grid.Row="1" />
                </Grid>
            </Border>
            <Border Grid.Row="1" Grid.Column="0" Stroke="{DynamicResource Border}" StrokeThickness="1" StrokeShape="RoundRectangle 4" BackgroundColor="{DynamicResource Surface}" Padding="0">
                <Grid RowDefinitions="16,*">
                    <Label x:Name="Label3" Text="3" FontSize="10" TextColor="{DynamicResource TextSecondary}" Margin="3,0" />
                    <WebView x:Name="WebView3" Grid.Row="1" />
                </Grid>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Stroke="{DynamicResource Border}" StrokeThickness="1" StrokeShape="RoundRectangle 4" BackgroundColor="{DynamicResource Surface}" Padding="0">
                <Grid RowDefinitions="16,*">
                    <Label x:Name="Label4" Text="4" FontSize="10" TextColor="{DynamicResource TextSecondary}" Margin="3,0" />
                    <WebView x:Name="WebView4" Grid.Row="1" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
