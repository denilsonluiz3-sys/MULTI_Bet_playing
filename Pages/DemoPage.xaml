<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MULTI_Bet_playing_Demo.Pages.DemoPage"
             Title="Demo 2×2"
             BackgroundColor="{DynamicResource Background}">

    <Grid RowDefinitions="Auto,*" Padding="4">
        <ScrollView Orientation="Horizontal" HeightRequest="48">
            <HorizontalStackLayout Spacing="6" Padding="4,0">
                <Button Text="Favoritos" Clicked="OnLoadFavorites" BackgroundColor="{DynamicResource Primary}"
                        TextColor="White" FontSize="11" HeightRequest="36" Padding="10,0" />
                <Button Text="Exemplos Pragmatic" Clicked="OnLoadPragmaticExamples" BackgroundColor="{DynamicResource Secondary}"
                        TextColor="Black" FontSize="11" HeightRequest="36" Padding="10,0" />
                <Button Text="Escolher slots" Clicked="OnPickSlots" BackgroundColor="{DynamicResource Surface}"
                        TextColor="{DynamicResource TextPrimary}" BorderColor="{DynamicResource Border}" BorderWidth="1"
                        FontSize="11" HeightRequest="36" Padding="10,0" />
                <Button Text="Limpar" Clicked="OnClearAll" BackgroundColor="{DynamicResource Accent}"
                        TextColor="White" FontSize="11" HeightRequest="36" Padding="10,0" />
            </HorizontalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1" RowDefinitions="*,*" ColumnDefinitions="*,*" RowSpacing="4" ColumnSpacing="4" Margin="4">
            <Border Grid.Row="0" Grid.Column="0" Stroke="{DynamicResource Border}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 8" BackgroundColor="{DynamicResource Surface}">
                <Grid RowDefinitions="Auto,*">
                    <Label x:Name="Label1" Text="Tela 1" FontSize="11" TextColor="{DynamicResource TextSecondary}" Margin="6,4" />
                    <WebView x:Name="WebView1" Grid.Row="1" />
                </Grid>
            </Border>
            <Border Grid.Row="0" Grid.Column="1" Stroke="{DynamicResource Border}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 8" BackgroundColor="{DynamicResource Surface}">
                <Grid RowDefinitions="Auto,*">
                    <Label x:Name="Label2" Text="Tela 2" FontSize="11" TextColor="{DynamicResource TextSecondary}" Margin="6,4" />
                    <WebView x:Name="WebView2" Grid.Row="1" />
                </Grid>
            </Border>
            <Border Grid.Row="1" Grid.Column="0" Stroke="{DynamicResource Border}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 8" BackgroundColor="{DynamicResource Surface}">
                <Grid RowDefinitions="Auto,*">
                    <Label x:Name="Label3" Text="Tela 3" FontSize="11" TextColor="{DynamicResource TextSecondary}" Margin="6,4" />
                    <WebView x:Name="WebView3" Grid.Row="1" />
                </Grid>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Stroke="{DynamicResource Border}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 8" BackgroundColor="{DynamicResource Surface}">
                <Grid RowDefinitions="Auto,*">
                    <Label x:Name="Label4" Text="Tela 4" FontSize="11" TextColor="{DynamicResource TextSecondary}" Margin="6,4" />
                    <WebView x:Name="WebView4" Grid.Row="1" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
