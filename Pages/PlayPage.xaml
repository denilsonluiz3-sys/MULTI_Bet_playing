<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MULTI_Bet_playing_Demo.Pages.PlayPage"
             Title="Play"
             BackgroundColor="{DynamicResource Background}">

    <Grid RowDefinitions="32,*" Padding="2" RowSpacing="2">

        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="2" Padding="2,0">
            <Label x:Name="StatusLabel" Text="Play" FontSize="11" TextColor="{DynamicResource TextSecondary}"
                   VerticalOptions="Center" LineBreakMode="TailTruncation" />
            <Button Grid.Column="1" Text="⭐" Clicked="OnLoadFavorites" FontSize="14"
                    HeightRequest="28" WidthRequest="36" Padding="0"
                    BackgroundColor="{DynamicResource Primary}" TextColor="White" />
            <Button Grid.Column="2" Text="＋" Clicked="OnPickSlots" FontSize="14"
                    HeightRequest="28" WidthRequest="36" Padding="0"
                    BackgroundColor="{DynamicResource Surface}" TextColor="{DynamicResource TextPrimary}"
                    BorderColor="{DynamicResource Border}" BorderWidth="1" />
            <Button Grid.Column="3" Text="⇄" Clicked="OnSwap" FontSize="14"
                    HeightRequest="28" WidthRequest="36" Padding="0"
                    BackgroundColor="{DynamicResource Surface}" TextColor="{DynamicResource TextPrimary}"
                    BorderColor="{DynamicResource Border}" BorderWidth="1" />
            <Button Grid.Column="4" x:Name="MuteAllBtn" Text="🔇" Clicked="OnMuteAll" FontSize="14"
                    HeightRequest="28" WidthRequest="36" Padding="0"
                    BackgroundColor="{DynamicResource Secondary}" TextColor="Black" />
            <Button Grid.Column="5" Text="⛶" Clicked="OnFullMenu" FontSize="14"
                    HeightRequest="28" WidthRequest="36" Padding="0"
                    BackgroundColor="{DynamicResource Surface}" TextColor="{DynamicResource TextPrimary}"
                    BorderColor="{DynamicResource Border}" BorderWidth="1" />
            <Button Grid.Column="6" Text="⋮" Clicked="OnMoreMenu" FontSize="16"
                    HeightRequest="28" WidthRequest="36" Padding="0"
                    BackgroundColor="{DynamicResource Surface}" TextColor="{DynamicResource TextPrimary}"
                    BorderColor="{DynamicResource Border}" BorderWidth="1" />
        </Grid>

        <Grid x:Name="ScreensGrid" Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="2">
            <Border x:Name="BorderLeft" Grid.Column="0" Stroke="{DynamicResource Border}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 4" BackgroundColor="{DynamicResource Surface}" Padding="0">
                <Grid RowDefinitions="18,*">
                    <Label x:Name="LabelLeft" Text="1" FontSize="10" TextColor="{DynamicResource TextSecondary}" Margin="4,1" LineBreakMode="TailTruncation" />
                    <WebView x:Name="WebViewLeft" Grid.Row="1" />
                </Grid>
            </Border>
            <Border x:Name="BorderRight" Grid.Column="1" Stroke="{DynamicResource Border}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 4" BackgroundColor="{DynamicResource Surface}" Padding="0">
                <Grid RowDefinitions="18,*">
                    <Label x:Name="LabelRight" Text="2" FontSize="10" TextColor="{DynamicResource TextSecondary}" Margin="4,1" LineBreakMode="TailTruncation" />
                    <WebView x:Name="WebViewRight" Grid.Row="1" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
