<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MULTI_Bet_playing_Demo.Resources.Themes.LightTheme">

    <Color x:Key="Primary">#5B21B6</Color>
    <Color x:Key="PrimaryDark">#4C1D95</Color>
    <Color x:Key="Secondary">#0D9488</Color>
    <Color x:Key="Background">#F3F4F6</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="TextPrimary">#111827</Color>
    <Color x:Key="TextSecondary">#374151</Color>
    <Color x:Key="Accent">#B91C1C</Color>
    <Color x:Key="Border">#9CA3AF</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Background}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackground}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />

</ResourceDictionary>
